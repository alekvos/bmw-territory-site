[Unit]
Description=BMW Territory booking email service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/bmw-territory-booking/current
Environment=NODE_ENV=production
EnvironmentFile=/etc/bmw-territory/booking.env
ExecStart=/usr/bin/node booking-service.mjs
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
MemoryMax=160M

[Install]
WantedBy=multi-user.target
